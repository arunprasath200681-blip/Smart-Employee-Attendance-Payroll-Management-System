<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Smart Employee Attendance and Payroll Management System</display-name>

    <!-- 1. Employee Servlet -->
    <servlet>
        <servlet-name>EmployeeServlet</servlet-name>
        <servlet-class>com.smartpayroll.EmployeeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeServlet</servlet-name>
        <url-pattern>/api/employees/*</url-pattern>
    </servlet-mapping>

    <!-- 2. Attendance Servlet -->
    <servlet>
        <servlet-name>AttendanceServlet</servlet-name>
        <servlet-class>com.smartpayroll.AttendanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttendanceServlet</servlet-name>
        <url-pattern>/api/attendance/*</url-pattern>
    </servlet-mapping>

    <!-- 3. Payroll Servlet -->
    <servlet>
        <servlet-name>PayrollServlet</servlet-name>
        <servlet-class>com.smartpayroll.PayrollServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PayrollServlet</servlet-name>
        <url-pattern>/api/payroll/*</url-pattern>
    </servlet-mapping>

    <!-- 4. Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.smartpayroll.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/api/dashboard/*</url-pattern>
    </servlet-mapping>

    <!-- Default Welcome Page -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
